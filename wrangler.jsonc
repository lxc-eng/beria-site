{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beria",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    // The website files
    "directory": "./beria",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; every other request is served straight from the files
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "beria.shroudberry.com", "custom_domain": true }
  ],
  "workers_dev": true,
  // Stores the server's status history (one sample every 5 minutes, last 24 hours)
  "kv_namespaces": [
    { "binding": "HISTORY", "id": "3824db572c2a4c4c8c771a23185c7aae" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": { "enabled": true }
  // Secret (set in the Cloudflare dashboard, never in this file): STEAM_API_KEY
}
