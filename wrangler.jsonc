{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beria",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    // The website files
    "directory": "./beria",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; every other request is served straight from the files
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "beria.shroudberry.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
  // Secret (set in the Cloudflare dashboard, never in this file): STEAM_API_KEY
}
